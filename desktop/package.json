{
  "name": "chocglass-desktop",
  "version": "1.0.0",
  "type": "module",
  "description": "ChocGlass Companion Server & Desktop App for Windows, macOS and Linux",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "dev:server": "node src/main/server.js",
    "dev:renderer": "vite",
    "dev": "concurrently \"vite\" \"wait-on tcp:5174 && electron .\"",
    "build:renderer": "vite build",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.chocglass.desktop",
    "productName": "ChocGlass Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Utility"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "qrcode.react": "^4.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
